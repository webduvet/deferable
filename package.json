{
	"name": "deferable",
	"version": "1.0.0",
	"description": "Deferred promises and lazy, trigger-on-demand promises for JavaScript and TypeScript. Zero dependencies.",
	"type": "module",
	"main": "./src/index.js",
	"types": "./src/index.d.ts",
	"exports": {
		".": {
			"types": "./src/index.d.ts",
			"default": "./src/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"src/index.js",
		"src/index.d.ts"
	],
	"sideEffects": false,
	"engines": {
		"node": ">=20.19"
	},
	"scripts": {
		"test": "node --test",
		"test:unit": "node --test test/defer.test.js test/deferred.test.js",
		"test:types": "tsc -p tsconfig.json",
		"coverage": "node --test --experimental-test-coverage test/defer.test.js test/deferred.test.js",
		"check": "npm run test:types && npm test",
		"example": "node examples/basic.js",
		"prepublishOnly": "npm run check"
	},
	"keywords": [
		"promise",
		"deferred",
		"defer",
		"lazy",
		"trigger",
		"throttle",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/webduvet/deferable.git"
	},
	"bugs": {
		"url": "https://github.com/webduvet/deferable/issues"
	},
	"homepage": "https://github.com/webduvet/deferable#readme",
	"author": "Andrej Bartko",
	"license": "MIT",
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"devDependencies": {
		"typescript": "^7.0.2"
	}
}
